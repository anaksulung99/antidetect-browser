# Runtime mode
# Neon remains the source of truth for the first production phase.
# The embedded mode is reserved for a future local database adapter.
DATABASE_MODE=neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional queue/cache integrations. Keep these in the Electron main process only.
CLOUDAMQP_URL=amqps://user:password@host/vhost
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Optional first-run admin bootstrap. The password is read only by Electron main
# process and is used only when this email does not yet exist.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-this-password

# Optional absolute override. Defaults to resources/browsers in development
# and <app resources>/browsers in a packaged build.
# BROWSER_BINARIES_PATH=D:\\laragon\\www\\tools\\antidetect\\antidetect-crawlee\\resources\\browsers
